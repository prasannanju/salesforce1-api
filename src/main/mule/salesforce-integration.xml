		<ee:transform doc:name="Transform Message" doc:id="7c31878b-6806-4f6c-ae07-32fb40c6be56" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
