	<configuration-properties doc:name="Configuration properties" doc:id="8b2ee22a-d788-4319-aa33-4e6008bae5ee" file="dev.yaml" />
	<file:config name="File_Config" doc:name="File Config" doc:id="34f06256-8cb9-48f3-a081-a12d5b11b10f" />
	<flow name="salesforce-integrationFlow" doc:id="21871aad-478b-4366-9dbf-4eeff8dcaf25" >
